---
import { Icon } from 'astro-icon/components';
import { contacts } from '../data/product';
---

<section id="contact" class="bg-snow py-20">
  <div class="shell">
    <div class="min-w-0">
      <p class="eyebrow">
        <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
        Контакты
      </p>

      <h2 class="mt-4 text-3xl font-extrabold sm:text-5xl">
        Ответим на вопросы
      </h2>

      <div class="mt-10 space-y-4">
        <a
          href={contacts.phoneHref}
          class="card flex items-center gap-4 p-5 hover:border-ink"
        >
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ink text-white"
          >
            <Icon name="lucide:phone" class="h-5 w-5" />
          </span>

          <span class="min-w-0">
            <span class="block text-xs font-bold uppercase tracking-wider text-steel">
              Телефон
            </span>
            <span class="mt-1 block text-base font-bold sm:text-lg">
              {contacts.phone}
            </span>
          </span>
        </a>

        <a
          href={`mailto:${contacts.email}`}
          class="card flex items-center gap-4 p-5 hover:border-ink"
        >
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ink text-white"
          >
            <Icon name="lucide:mail" class="h-5 w-5" />
          </span>

          <span class="min-w-0">
            <span class="block text-xs font-bold uppercase tracking-wider text-steel">
              Email
            </span>
            <span class="mt-1 block break-all text-base font-bold sm:text-lg">
              {contacts.email}
            </span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>