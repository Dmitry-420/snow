---
import { Icon } from 'astro-icon/components';
import ContactForm from './ContactForm.vue';
import { contacts } from '../data/product';
---

<section id="contact" class="bg-snow py-20">
  <div class="shell grid gap-10 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="min-w-0">
      <p class="eyebrow">
        <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
        Контакты
      </p>

      <h2 class="mt-4 text-3xl font-extrabold sm:text-5xl">
        Ответим на вопросы
      </h2>

      <p class="mt-4 max-w-md text-lg text-ink/65">
        Укажите размер обуви и вес со снаряжением —
        подскажем, подойдёт ли модель.
      </p>

      <div class="mt-10 space-y-4">
        <a
          href={contacts.phoneHref}
          class="card flex items-center gap-4 p-5 hover:border-ink"
        >
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ink text-white"
          >
            <Icon name="lucide:phone" class="h-5 w-5" />
          </span>

          <span class="min-w-0">
            <span class="block text-xs font-bold uppercase tracking-wider text-steel">
              Телефон
            </span>
            <span class="mt-1 block text-base font-bold sm:text-lg">
              {contacts.phone}
            </span>
          </span>
        </a>

        <a
          href={`mailto:${contacts.email}`}
          class="card flex items-center gap-4 p-5 hover:border-ink"
        >
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ink text-white"
          >
            <Icon name="lucide:mail" class="h-5 w-5" />
          </span>

          <span class="min-w-0">
            <span class="block text-xs font-bold uppercase tracking-wider text-steel">
              Email
            </span>
            <span class="mt-1 block break-all text-base font-bold sm:text-lg">
              {contacts.email}
            </span>
          </span>
        </a>
      </div>

      <div
        class="mt-8 rounded-2xl border border-line bg-white/70 p-5 text-xs leading-relaxed text-ink/65"
      >
        <p class="font-bold text-ink">{contacts.company}</p>
        <p class="mt-1">ИНН {contacts.inn}</p>
        <p>ОГРНИП {contacts.ogrn}</p>
        <p class="mt-2">Российская Федерация</p>
      </div>
    </div>

    <div class="card min-w-0 p-6 sm:p-10">
      <h3 class="text-2xl font-extrabold">Подготовить вопрос</h3>

      <p class="mt-3 text-sm leading-relaxed text-ink/65">
        Заполните поля — откроется ваша почтовая программа с готовым
        письмом. Отправку нужно подтвердить в ней.
      </p>

      <ContactForm client:load />
    </div>
  </div>
</section>