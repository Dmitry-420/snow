---
import { Icon } from 'astro-icon/components';
import { faq } from '../data/product';
---

<section id="faq" class="border-b border-line bg-white py-20">
  <div class="shell grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow">
        <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
        Вопросы
      </p>

      <h2 class="mt-4 text-3xl font-extrabold sm:text-5xl">
        Что спрашивают чаще
      </h2>

      <p class="mt-4 text-lg text-ink/65">
        О размере, нагрузке, морозе и гарантии.
        Не нашли свой вопрос — напишите нам.
      </p>

      <a href="#contact" class="btn btn-dark mt-8">
        <Icon name="lucide:send" class="h-4 w-4" />
        Задать вопрос
      </a>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {
        faq.map((item) => (
          <details class="group py-5">
            <summary class="flex list-none items-start justify-between gap-5 text-base font-bold text-ink">
              <span>{item.q}</span>

              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-line text-steel transition group-open:rotate-180 group-open:border-ink group-open:text-ink">
                <Icon name="lucide:chevron-down" class="h-4 w-4" />
              </span>
            </summary>

            <p class="mt-3 max-w-2xl pr-8 text-sm leading-relaxed text-ink/65">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>