---
import { Icon } from 'astro-icon/components';
import { buyLinks, contacts } from '../data/product';

const year = new Date().getFullYear();

const sections = [
  { label: 'Характеристики', href: '#specs' },
  { label: 'Галерея', href: '#gallery' },
  { label: 'Комплект', href: '#in-the-box' },
  { label: 'Вопросы', href: '#faq' },
  { label: 'Контакты', href: '#contact' },
];
---

<footer class="site-footer bg-ink pt-14 text-white">
  <div class="shell">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr_0.8fr]">
      <div>
        <a href="#top" class="inline-flex items-center gap-3">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 font-heading text-[13px] font-black"
          >
            P9
          </span>

          <span class="leading-none">
            <span
              class="block font-heading text-base font-extrabold tracking-[0.18em]"
            >
              PRONINE
            </span>
            <span
              class="mt-1 block text-[10px] font-semibold uppercase tracking-[0.3em] text-white/55"
            >
              ArcticSport
            </span>
          </span>
        </a>

        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/60">
          Снегоступы Tactic 930: алюминиевая рама,
          крепления easy fix и чехол для переноски.
        </p>
      </div>

      <nav aria-label="Навигация в подвале">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-white/55">
          Разделы
        </p>

        <ul class="mt-5 space-y-3 text-sm">
          {
            sections.map((section) => (
              <li>
                <a
                  href={section.href}
                  class="text-white/75 hover:text-amber"
                >
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-white/55">
          Где купить
        </p>

        <ul class="mt-5 space-y-3 text-sm">
          {
            buyLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white/75 hover:text-amber"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-6 space-y-3 text-sm">
          <a
            href={contacts.phoneHref}
            class="flex items-center gap-2 text-white/75 hover:text-amber"
          >
            <Icon name="lucide:phone" class="h-4 w-4 shrink-0" />
            {contacts.phone}
          </a>

          <a
            href={`mailto:${contacts.email}`}
            class="flex items-center gap-2 text-white/75 hover:text-amber"
          >
            <Icon name="lucide:mail" class="h-4 w-4 shrink-0" />
            {contacts.email}
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-12 border-t border-white/10 pt-6 text-xs leading-relaxed text-white/55"
    >
      <p>{contacts.company}</p>
      <p class="mt-1">
        ИНН {contacts.inn} · ОГРНИП {contacts.ogrn}
      </p>
      <p class="mt-3">
        © {year} PRONINE ArcticSport. Продажа через маркетплейсы.
      </p>
    </div>
  </div>
</footer>