---
import { Icon } from 'astro-icon/components';
import { contacts } from '../data/product';

const nav = [
  { label: 'Характеристики', href: '#specs' },
  { label: 'Галерея', href: '#gallery' },
  { label: 'Комплект', href: '#in-the-box' },
  { label: 'Вопросы', href: '#faq' },
  { label: 'Контакты', href: '#contact' },
];
---

<header
  class="sticky top-0 z-50 border-b border-line/80 bg-snow/95 backdrop-blur-xl"
>
  <div class="shell flex h-16 items-center justify-between gap-4 md:h-20">
    <a
      href="#top"
      class="flex shrink-0 items-center gap-3"
      aria-label="PRONINE ArcticSport — начало страницы"
    >
      <span
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-ink font-heading text-[13px] font-black text-white"
      >
        P9
      </span>

      <span class="leading-none">
        <span
          class="block font-heading text-sm font-extrabold tracking-[0.12em] sm:text-base"
        >
          PRONINE
        </span>
        <span
          class="mt-1 block text-[10px] font-semibold uppercase tracking-[0.3em] text-steel"
        >
          ArcticSport
        </span>
      </span>
    </a>

    <nav
      class="hidden items-center gap-5 lg:flex"
      aria-label="Основная навигация"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold text-ink/70 hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={contacts.phoneHref}
        class="hidden items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-sm font-bold hover:border-ink xl:inline-flex"
      >
        <Icon name="lucide:phone" class="h-4 w-4" />
        {contacts.phone}
      </a>

      <a href="#buy" class="btn btn-primary hidden sm:inline-flex">
        Купить
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>

      <a
        href="#buy"
        class="btn btn-primary px-4 py-3 sm:hidden"
        aria-label="Перейти к покупке"
      >
        <Icon name="lucide:shopping-cart" class="h-4 w-4" />
      </a>
    </div>
  </div>
</header>