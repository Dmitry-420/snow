---
import { Icon } from 'astro-icon/components';
import { contacts } from '../data/product';
---

<div
  class="mobile-bar fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 px-4 pt-3 backdrop-blur-xl md:hidden"
  role="region"
  aria-label="Быстрая покупка и звонок"
>
  <div class="mx-auto flex max-w-xl items-center gap-3">
    <a href="#buy" class="btn btn-primary min-w-0 flex-1">
      Где купить
    </a>

    <a
      href={contacts.phoneHref}
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-line bg-white text-ink"
      aria-label={`Позвонить: ${contacts.phone}`}
    >
      <Icon name="lucide:phone" class="h-5 w-5" />
    </a>
  </div>
</div>